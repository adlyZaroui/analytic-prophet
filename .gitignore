# Virtual environments
.venv/
venv/
env/

# Python cache files
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Locally-built C++ core (see analytic_prophet/optimize.cpp's trailing comment
# / tests/conftest.py)
*.so
*.dylib

# Packaging artifacts. `pip install -e .` drops an egg-info directory in the
# repo root; build/ and dist/ come from a non-editable build.
*.egg-info/
build/
dist/

# Third-party licence texts, collected at build time by
# tools/collect_licences.py out of the fetched Eigen and LBFGSpp trees (#97).
# A build artifact, not source: nothing in the repository vendors either
# library, which is why `package-data` names them with a glob.
analytic_prophet/licences/
